# Instant notification to the founders. Set at least one. Nothing is hardcoded.
# 1) ntfy.sh push (free, no account): pick an unguessable topic, then subscribe to it in the ntfy app on both phones.
NTFY_TOPIC=
# 2) Telegram bot: create a bot with @BotFather, each founder sends /start to it, then list their chat ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# 3) Email copy via Resend (free tier covers this volume).
RESEND_API_KEY=
RESEND_FROM=Aperture site <onboarding@resend.dev>
LEAD_EMAIL_TO=atharvasingh0405@gmail.com,shishodiasanidhya@gmail.com

# AI that restates the visitor's need and maps it to our services. Optional: without it a keyword fallback is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: your Cal.com (or Calendly) booking link. When set, a "Book 15 minutes" option appears on the Contact page.
NEXT_PUBLIC_BOOKING_URL=
